# Do not commit real keys.
# Text LLM (Qwen OpenAI-compatible API).
# If TEXT_LLM_API_KEY is empty, the app falls back to DASHSCOPE_API_KEY.
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://ws-7s8hh8dksjtq6j2u.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TEXT_LLM_MODEL=qwen3.6-plus
# Keep this false for fast, direct ad-copy generation; enable only when you
# explicitly want the model's reasoning mode.
TEXT_LLM_ENABLE_THINKING=false

# Legacy DeepSeek variables are accepted for older integrations but are no
# longer used by the app's text generation path.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-chat

# Qwen is used for vision understanding and TTS.
DASHSCOPE_API_KEY=
# Deprecated compatibility variable for the old text-model status field.
QWEN_TEXT_MODEL=qwen3.6-plus
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Serena
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Default render engine is internal and portable.
# Set to moneyprinter only if you deliberately want to call the full external pipeline.
EXHIBITFLOW_RENDER_ENGINE=internal

# Portable defaults. These live inside exhibitflow-lite after copying the folder.
EXHIBITFLOW_MATERIAL_DIR=./materials
EXHIBITFLOW_COMPETITOR_DIR=./storage/downloads

# Optional plugins. Leave empty unless you copied/configured these tools.
SOCIAL_CRAWLER_DIR=./vendor/social_crawler
MONEYPRINTERTURBO_DIR=./vendor/money_pipeline

# Optional managed public Douyin search provider. In mainland China use the
# accelerated api.tikhub.dev domain; the API path is identical on api.tikhub.io.
# TikHub's dedicated Douyin search endpoint is billed per request.
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev
# auto: prefer TikHub for Douyin when a key exists, otherwise use local crawler.
# local: always use the browser/local crawler. tikhub: require TikHub for Douyin.
SOCIAL_SEARCH_PROVIDER=auto

# Optional managed public Xiaohongshu search provider.  Rnote does not need
# the visitor's Xiaohongshu login; it is used only by the hunter employee.
RNOTE_API_KEY=
RNOTE_BASE_URL=https://rnote.dev/api/v2/crawler

SAU_BIN=./vendor/social_auto_upload/.venv/bin/sau
# 巨量引擎 Marketing API / OceanEngine
# 从 https://open.oceanengine.com/developer/admin 应用基本信息获取 APP_ID 和 Secret。
OCEANENGINE_APP_ID=
OCEANENGINE_SECRET=
# 必须和巨量开放平台应用后台填写的回调地址完全一致。
# Must be the exact callback URL registered in the Ocean Engine Open Platform.
# Public deployment example:
# OCEANENGINE_REDIRECT_URI=https://your-domain.example/exhibitflow-api/api/oceanengine/callback
OCEANENGINE_REDIRECT_URI=http://localhost:8610/api/oceanengine/callback
# 可选：也可由服务器私有配置直接提供。生成后的“上传到巨量素材库”按钮
# 只读取服务端变量，绝不会把 Access Token 下发到浏览器或提交到 Git。
OCEANENGINE_ACCESS_TOKEN=
OCEANENGINE_REFRESH_TOKEN=
OCEANENGINE_ADVERTISER_ID=

# Optional Tencent Marketing API for Video Channels paid delivery.  The first
# integration is read-only and uses /v1.3/adcreatives/get.
TENCENT_ADS_BASE_URL=https://api.e.qq.com
TENCENT_ADS_ACCESS_TOKEN=
TENCENT_ADS_REFRESH_TOKEN=
TENCENT_ADS_CLIENT_ID=
TENCENT_ADS_CLIENT_SECRET=
TENCENT_ADS_ACCOUNT_ID=

# 数字人 / AI 视频（AI 自动补充）。未配置时前端数字人开关保持禁用。
# RunningHub：服务端上传人物形象和 Edge TTS 音频，提交数字人工作流并轮询 MP4。
# 工作流图片节点、音频节点若不是 1.image / 2.audio，请改成实际节点。
AVATAR_PROVIDER=
RUNNINGHUB_API_KEY=
RUNNINGHUB_API_URL=https://www.runninghub.cn
RUNNINGHUB_DIGITAL_HUMAN_WORKFLOW_ID=2003717471859294210
RUNNINGHUB_INSTANCE_TYPE=plus
RUNNINGHUB_QUEUE_MAXED_RETRY_COUNT=120
RUNNINGHUB_QUEUE_MAXED_RETRY_MS=10000
RUNNINGHUB_DIGITAL_HUMAN_IMAGE_NODE_ID=133
RUNNINGHUB_DIGITAL_HUMAN_IMAGE_FIELD=image
RUNNINGHUB_DIGITAL_HUMAN_AUDIO_NODE_ID=253
RUNNINGHUB_DIGITAL_HUMAN_AUDIO_FIELD=audio
RUNNINGHUB_DIGITAL_HUMAN_POLL_SECONDS=2
RUNNINGHUB_DIGITAL_HUMAN_MAX_POLLS=1200

# Tripo3D 图生 3D。未配置时「产品展示」只能上传，不能提交生成。
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v3.0-20250812
TRIPO_TEXTURE_QUALITY=standard
TRIPO_FACE_LIMIT=50000
# 可选：公网访问前缀，用于二维码里的完整链接，例如 https://your-domain
TRIPO_PUBLIC_BASE_URL=
# 兼容已有 HeyGen 配置；当前新前端默认接入 RunningHub。
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# 火山数字人（接入中，先用 HeyGen）
VOLC_AVATAR_BASE_URL=
VOLC_AVATAR_TOKEN=
VOLC_AVATAR_ID=

# 如果巨量后台回调仍是 http://localhost:8501，可临时用下面端口启动独立版：
# EXHIBITFLOW_PORT=8501
